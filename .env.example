# Copier ce fichier en .env puis adapter les valeurs.

# Environnement : development | production | test
NODE_ENV=development

# Port d'écoute du serveur
PORT=3000

# URI de connexion MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/my_social_networks

# Secret de signature des JWT (32 caractères minimum).
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire_de_32_caracteres_minimum

# Durée de validité du token (ex : 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Origines autorisées par CORS, séparées par des virgules ('*' est refusé)
CORS_ORIGINS=http://localhost:5173

# HTTPS : false = serveur HTTP, true = serveur HTTPS avec les certificats ci-dessous
USE_HTTPS=false
SSL_KEY_PATH=certs/server.key
SSL_CERT_PATH=certs/server.crt

# URL publique de l'application cliente, utilisée pour les liens de partage d'événement
PUBLIC_APP_URL=http://localhost:5173

# Limitation du taux de requêtes (par adresse IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
